{
  "sdkVersion": "1.0",
  "id": "bears.bookshelf",
  "name": "熊的书架",
  "version": "0.2.0",
  "author": "陆沉 & 悦悦",
  "description": "熊和兔的书架：收藏、各自的阅读进度、原文旁批注，可以互相偷看。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": ["app.data.read", "app.data.write", "chat.tools", "network.fetch", "ui.toast", "ui.confirm"],
  "network": { "allowedDomains": ["gutenberg.org", "*.gutenberg.org"] },
  "extensions": {
    "tools": [
      {
        "id": "shelf-add-book",
        "name": "书架加一本书",
        "description": "往书架上新增一本书，只记书名、作者、简介、出处，不含正文。owner 填 bear（熊的那层）或 bunny（兔子的那层）。",
        "visibility": "shared",
        "handler": "addBook",
        "parameterSchema": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "description": "书名" },
            "author": { "type": "string", "description": "作者" },
            "summary": { "type": "string", "description": "一段简介" },
            "source": { "type": "string", "description": "出处或网址" },
            "owner": { "type": "string", "description": "bear 或 bunny" },
            "status": { "type": "string", "description": "想读 / 在读 / 读完" }
          },
          "required": ["title", "owner"]
        }
      },
      {
        "id": "shelf-import-url",
        "name": "书架从网址导入正文",
        "description": "给书架上的一本书导入全文：书架自己去网址下载 txt 并切章节，会覆盖旧正文。只允许古腾堡地址。知道章节标题时填 headings，切得最准。",
        "visibility": "shared",
        "handler": "importFromUrl",
        "timeoutMs": 600000,
        "parameterSchema": {
          "type": "object",
          "properties": {
            "bookId": { "type": "string", "description": "书的 id，或书名" },
            "url": { "type": "string", "description": "txt 文件地址" },
            "headings": { "type": "array", "items": { "type": "string" }, "description": "按顺序写出各章标题，和原文里的标题行一致（不分大小写），可不填" }
          },
          "required": ["bookId", "url"]
        }
      },
      {
        "id": "shelf-read-section",
        "name": "书架读一段",
        "description": "熊读某本书某一章，从第 part 份开始连读 count 份（每份约三千字符，最多三份），返回原文、这几份里的批注和下一次该从哪读，并记进熊的进度。",
        "visibility": "shared",
        "handler": "readSection",
        "parameterSchema": {
          "type": "object",
          "properties": {
            "bookId": { "type": "string", "description": "书的 id，或书名" },
            "chapter": { "type": "number", "description": "第几章，从 1 开始" },
            "part": { "type": "number", "description": "从这一章第几份开始，默认 1" },
            "count": { "type": "number", "description": "连读几份，1 到 3，默认 1" }
          },
          "required": ["bookId", "chapter"]
        }
      },
      {
        "id": "shelf-add-note",
        "name": "书架写批注",
        "description": "在某本书某一章的某句原文旁边留一条批注；replyTo 填已有批注 id 时，就是在那条底下回一句。",
        "visibility": "shared",
        "handler": "addNote",
        "parameterSchema": {
          "type": "object",
          "properties": {
            "bookId": { "type": "string" },
            "chapter": { "type": "number" },
            "quote": { "type": "string", "description": "摘下来的那句原文，要和正文一字不差" },
            "text": { "type": "string", "description": "批注内容" },
            "author": { "type": "string", "description": "bear 或 bunny" },
            "replyTo": { "type": "string", "description": "回复的批注 id，可不填" }
          },
          "required": ["bookId", "chapter", "quote", "text", "author"]
        }
      },
      {
        "id": "shelf-list",
        "name": "书架看一眼",
        "description": "看整个书架：每本书在哪一层、状态、熊和兔子各读到哪、有没有正文、有几条批注。",
        "visibility": "shared",
        "handler": "listShelf",
        "parameterSchema": {
          "type": "object",
          "properties": { "owner": { "type": "string", "description": "只看 bear 或 bunny 那一层，可不填" } }
        }
      }
    ]
  }
}
